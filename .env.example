# Copy this file to .env and fill in your own values. Never commit .env.

# Generate once with: python -c "import secrets; print(secrets.token_hex(32))"
# (it does not expire - only the login tokens do, after 24 hours)
SECRET_KEY=change-me

MYSQL_USER=root
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me
MYSQL_DB=rag_app

GROQ_API_KEY=change-me
# Groq retires models over time. If chat says the answer service is unavailable,
# pick a current one from https://console.groq.com/docs/models
GROQ_MODEL=openai/gpt-oss-120b

# ── Hosts ──────────────────────────────────────────────────────────
# These are the values for running the backend directly with uvicorn.
# docker-compose overrides them automatically inside the containers.
MYSQL_HOST=localhost
# 3306 for a local MySQL install, 3307 for the MySQL container from docker-compose
MYSQL_PORT=3306
CHROMA_HOST=localhost
CHROMA_PORT=8001

# Optional
# CORS_ORIGINS=http://localhost:3000
# Hybrid search reranks candidates with a small cross-encoder (downloaded once,
# about 90 MB). Set to 0 to skip it and use the fused vector + keyword order.
# RERANK_ENABLED=1
# RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
