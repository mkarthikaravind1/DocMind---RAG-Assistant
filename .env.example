# Copy this file to .env and fill in your own values. Never commit .env.

# Generate once with: python -c "import secrets; print(secrets.token_hex(32))"
# (it does not expire - only the tokens signed with it do)
SECRET_KEY=change-me

MYSQL_USER=root
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me
MYSQL_DB=rag_app

GROQ_API_KEY=change-me
# Groq retires models over time. If chat says the answer service is unavailable,
# pick a current one from https://console.groq.com/docs/models
GROQ_MODEL=openai/gpt-oss-120b

# ── Hosts ──────────────────────────────────────────────────────────
# These are the values for running the backend directly with uvicorn.
# docker-compose overrides them automatically inside the containers.
MYSQL_HOST=localhost
# 3306 for a local MySQL install, 3307 for the MySQL container from docker-compose
MYSQL_PORT=3306
CHROMA_HOST=localhost
CHROMA_PORT=8001

# Optional
# ── Sessions ───────────────────────────────────────────────────────
# The access token lasts minutes; the browser renews it with a refresh token
# kept in an httpOnly cookie.
# ACCESS_TOKEN_EXPIRE_MINUTES=15
# REFRESH_TOKEN_EXPIRE_DAYS=7
# Set to 1 when the app is served over HTTPS (the cookie is then HTTPS-only)
# COOKIE_SECURE=0
# lax = frontend and API on the same site. Different sites need none + COOKIE_SECURE=1
# COOKIE_SAMESITE=lax

# ── Rate limits, written as count/seconds ──────────────────────────
# RATE_LIMIT_ENABLED=1
# RATE_LIMIT_LOGIN=5/300        failed sign-ins per account
# RATE_LIMIT_LOGIN_IP=30/300    sign-in attempts per address
# RATE_LIMIT_REGISTER=5/3600    new accounts per address
# RATE_LIMIT_CHAT=20/60         questions per user
# RATE_LIMIT_UPLOAD=10/600      uploads per user

# CORS_ORIGINS=http://localhost:3000
# Hybrid search reranks candidates with a small cross-encoder (downloaded once,
# about 90 MB). Set to 0 to skip it and use the fused vector + keyword order.
# RERANK_ENABLED=1
# RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Answer quality scores (faithfulness, answer relevancy) for the admin dashboard.
# Share of answers that are evaluated, each costing 3 extra LLM calls:
# 1 = all, 0.25 = one in four, 0 = off.
# EVAL_SAMPLE_RATE=1
# Judge model for the scores. Leave unset to use GROQ_MODEL.
# EVAL_MODEL=
